# Source this from bash or zsh:  source path/to/data_repo/activate
# See ADR-004 §4 for full semantics.

if [ -n "${BASH_SOURCE-}" ]; then
    _ANALYSIS_SELF="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION-}" ]; then
    # shellcheck disable=SC2296
    _ANALYSIS_SELF="${(%):-%x}"
else
    echo "activate: source from bash or zsh" >&2
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
fi

_ANALYSIS_OLD_PS1="${PS1-}"
export ANALYSIS_DATA_DIR
ANALYSIS_DATA_DIR="$(cd "$(dirname "$_ANALYSIS_SELF")" && pwd)"
export ANALYSIS_DATA_REPO_NAME="${ANALYSIS_DATA_REPO_NAME:-$(basename "$ANALYSIS_DATA_DIR")}"

if [ -z "${ANALYSIS_USER-}" ]; then
    printf "ANALYSIS_USER: " >&2
    read -r ANALYSIS_USER
fi

if ! grep -qE "^${ANALYSIS_USER}," "$ANALYSIS_DATA_DIR/persons.csv" 2>/dev/null; then
    echo "activate: ANALYSIS_USER='$ANALYSIS_USER' not found in $ANALYSIS_DATA_DIR/persons.csv" >&2
    unset ANALYSIS_USER _ANALYSIS_SELF _ANALYSIS_OLD_PS1
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1 ## ignore
fi
export ANALYSIS_USER

export PS1="[analysis:$ANALYSIS_DATA_REPO_NAME:$ANALYSIS_USER] ${_ANALYSIS_OLD_PS1}"

deactivate() {
    export PS1="$_ANALYSIS_OLD_PS1"
    unset ANALYSIS_DATA_DIR ANALYSIS_USER ANALYSIS_DATA_REPO_NAME
    unset _ANALYSIS_OLD_PS1 _ANALYSIS_SELF
    unset -f deactivate
}

# Source this from bash or zsh:  source path/to/data_repo/activate-analysis
# See ADR-004 §4 for full semantics.

if [ -n "${BASH_SOURCE-}" ]; then
	_ANALYSIS_SELF="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION-}" ]; then
	# shellcheck disable=SC2296
	_ANALYSIS_SELF="${(%):-%x}"
else
	echo "activate-analysis: source from bash or zsh" >&2
	# shellcheck disable=SC2317
	return 1 2>/dev/null || exit 1
fi

_analysis_fail() {
	echo "activate-analysis: $*" >&2
	# shellcheck disable=SC2317
	return 1 2>/dev/null || exit 1
}

_analysis_validate_repo_dir() {
	[ -n "$1" ] || return 1
	[ -d "$1" ] || return 1
	[ -f "$1/pyproject.toml" ] || return 1
	[ -f "$1/src/analysis/cli.py" ] || return 1
	[ -f "$1/src/analysis/amazon/cli.py" ] || return 1
	[ -f "$1/src/analysis/sim/cli.py" ] || return 1
	return 0
}

_analysis_enable_completion() {
	# Click completion env var differs by command name.
	_analysis_shell_mode="$1"
	eval "$(_ANALYSIS_COMPLETE=${_analysis_shell_mode} analysis)" 2>/dev/null || true
	eval "$(_AMAZON_COMPLETE=${_analysis_shell_mode} amazon)" 2>/dev/null || true
	eval "$(_SIM_COMPLETE=${_analysis_shell_mode} sim)" 2>/dev/null || true
	unset _analysis_shell_mode
}

export ANALYSIS_DATA_DIR
ANALYSIS_DATA_DIR="$(cd "$(dirname "$_ANALYSIS_SELF")" && pwd)"
export ANALYSIS_DATA_REPO_NAME="${ANALYSIS_DATA_REPO_NAME:-$(basename "$ANALYSIS_DATA_DIR")}"

_ANALYSIS_POINTER_FILE="$ANALYSIS_DATA_DIR/.analysis"
_ANALYSIS_REPO_CANDIDATE="${ANALYSIS_REPO_DIR-}"

if [ -z "$_ANALYSIS_REPO_CANDIDATE" ] && [ -f "$_ANALYSIS_POINTER_FILE" ]; then
	IFS= read -r _ANALYSIS_REPO_CANDIDATE < "$_ANALYSIS_POINTER_FILE"
fi

if ! _analysis_validate_repo_dir "$_ANALYSIS_REPO_CANDIDATE"; then
	echo "activate-analysis: analysis program repo path not configured." >&2
	printf "ANALYSIS_REPO_DIR: " >&2
	read -r _ANALYSIS_REPO_CANDIDATE
fi

if ! _analysis_validate_repo_dir "$_ANALYSIS_REPO_CANDIDATE"; then
	_analysis_fail "invalid repo path: '$_ANALYSIS_REPO_CANDIDATE' (expected pyproject.toml and src/analysis/*/cli.py)"
fi

export ANALYSIS_REPO_DIR="$_ANALYSIS_REPO_CANDIDATE"

# Persist pointer and ensure it is ignored by the data repo.
printf '%s\n' "$ANALYSIS_REPO_DIR" > "$_ANALYSIS_POINTER_FILE" || \
	_analysis_fail "unable to write $_ANALYSIS_POINTER_FILE"

for _analysis_ignored in .analysis .current_scenario; do
	if [ ! -f "$ANALYSIS_DATA_DIR/.gitignore" ]; then
		printf '%s\n' "$_analysis_ignored" > "$ANALYSIS_DATA_DIR/.gitignore" || \
			_analysis_fail "unable to write $ANALYSIS_DATA_DIR/.gitignore"
	elif ! grep -qxF "$_analysis_ignored" "$ANALYSIS_DATA_DIR/.gitignore"; then
		printf '%s\n' "$_analysis_ignored" >> "$ANALYSIS_DATA_DIR/.gitignore" || \
			_analysis_fail "unable to update $ANALYSIS_DATA_DIR/.gitignore"
	fi
done
unset _analysis_ignored

if [ ! -f "$ANALYSIS_REPO_DIR/.venv/bin/activate" ]; then
	command -v uv >/dev/null 2>&1 || _analysis_fail "uv not found; install uv to bootstrap .venv"
	(
		cd "$ANALYSIS_REPO_DIR" || exit 1
		uv sync --group dev
	) || _analysis_fail "uv sync failed while creating $ANALYSIS_REPO_DIR/.venv"
fi

# Activate the project virtual environment.
# shellcheck disable=SC1090,SC1091
. "$ANALYSIS_REPO_DIR/.venv/bin/activate" || _analysis_fail "failed to activate .venv"

if [ -z "${ANALYSIS_USER-}" ]; then
	printf "ANALYSIS_USER: " >&2
	read -r ANALYSIS_USER
fi

if ! grep -qE "^${ANALYSIS_USER}," "$ANALYSIS_DATA_DIR/persons.csv" 2>/dev/null; then
	unset ANALYSIS_USER
	_analysis_fail "ANALYSIS_USER not found in $ANALYSIS_DATA_DIR/persons.csv"
fi
export ANALYSIS_USER

if [ -n "${ZSH_VERSION-}" ]; then
	_analysis_enable_completion "zsh_source"
elif [ -n "${BASH_VERSION-}" ]; then
	_analysis_enable_completion "bash_source"
fi

# Prompt segment, in the style of oh-my-zsh's git_prompt_info: PS1 holds a
# literal $(analysis_prompt_info) that is expanded at each prompt, so it is
# added only once no matter how many times this script is sourced.
analysis_prompt_info() {
	[ -n "${ANALYSIS_DATA_REPO_NAME-}" ] && [ -n "${ANALYSIS_USER-}" ] || return 0
	printf '[analysis:%s:%s] ' "$ANALYSIS_DATA_REPO_NAME" "$ANALYSIS_USER"
}

if [ -n "${ZSH_VERSION-}" ]; then
	setopt prompt_subst
fi
# shellcheck disable=SC2016
case "${PS1-}" in
	*'$(analysis_prompt_info)'*) ;;
	*) PS1='$(analysis_prompt_info)'"${PS1-}" ;;
esac

deactivate-analysis() {
	# shellcheck disable=SC2016
	PS1="${PS1//'$(analysis_prompt_info)'/}"
	if typeset -f deactivate >/dev/null 2>&1; then
		deactivate
	fi
	unset ANALYSIS_DATA_DIR ANALYSIS_USER ANALYSIS_DATA_REPO_NAME ANALYSIS_REPO_DIR
	unset _ANALYSIS_SELF
	unset _ANALYSIS_POINTER_FILE _ANALYSIS_REPO_CANDIDATE
	unset -f _analysis_fail _analysis_validate_repo_dir _analysis_enable_completion
	unset -f analysis_prompt_info deactivate-analysis
}